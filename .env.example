# Postgres (Neon, Vercel Postgres, Supabase, etc.)
# DATABASE_URL is pooled for the app. DATABASE_URL_UNPOOLED is used by migrations when present.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=

# Admin login. ADMIN_SESSION_SECRET is optional; it defaults to ADMIN_PASSWORD.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Protects /api/cron/sync. Vercel Cron sends this as a Bearer token.
CRON_SECRET=change-me-three

# Vercel Blob, only needed for logo uploads from the admin.
BLOB_READ_WRITE_TOKEN=
